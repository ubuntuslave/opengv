{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (tests on, python off)",
      "description": "Configure OpenGV for C++ tests using Unix Makefiles.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_PYTHON": "OFF"
      }
    },
    {
      "name": "python",
      "displayName": "Python bindings",
      "description": "Configure OpenGV with Python bindings enabled.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-python",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_PYTHON": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "python",
      "configurePreset": "python"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
